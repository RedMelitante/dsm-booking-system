{
  // Cloudflare Workers: serves the built app from ./dist as static assets.
  // Unknown paths (/dashboard/..., /[business-slug]) fall back to index.html so
  // the client router can handle them. Add `main` here when the API Worker lands.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsm-booking-system",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
