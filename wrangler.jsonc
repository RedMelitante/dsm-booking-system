{
  // Cloudflare Workers: /api/* is handled by worker/index.js; everything else is
  // the built app in ./dist. Unknown paths (/dashboard/..., /[business-slug])
  // fall back to index.html so the client router can handle them.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsm-booking-system",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // No database_id: `wrangler deploy` creates the D1 database on the first deploy
  // and reuses it after that. The Worker applies migrations/ itself on first use.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsm-booking",
      "migrations_dir": "migrations"
    }
  ],
  // Lets the Worker import the migration files as text.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    // Verified sender address for Resend, e.g. "bookings@yourdomain.com". Leave empty to log emails instead.
    "EMAIL_FROM": "",
    // Google OAuth client ID. Leave empty to hide Google sign-in and Calendar.
    "GOOGLE_CLIENT_ID": ""
  },
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put NAME`): RESEND_API_KEY, GOOGLE_CLIENT_SECRET
}
